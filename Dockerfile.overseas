FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CURRENT_ENV=prod \
    PYTHONPATH=/app

WORKDIR /app
COPY requirements-overseas.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY . /app

CMD ["python", "-m", "collectors.group_runner"]
